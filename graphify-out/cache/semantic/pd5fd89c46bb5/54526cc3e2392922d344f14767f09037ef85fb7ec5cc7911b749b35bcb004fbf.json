{"nodes": [{"id": "_claude_skills_graphify_references_query_query_expansion", "label": "Constrained Query Expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query CLI matches by case-folded substring + IDF with no stemming, synonyms or cross-language mapping, so a wording mismatch returns zero hits. Expansion is constrained to tokens actually present in graph.json node labels to prevent fabricating a search."}, {"id": "_claude_skills_graphify_references_query_bfs_dfs_traversal", "label": "BFS and DFS Traversal Modes", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BFS answers 'what is X connected to' with layered neighbors to depth 3; DFS traces 'how does X reach Y' depth-limited to 6 so it does not walk the whole graph."}, {"id": "_claude_skills_graphify_references_query_token_budget", "label": "Query Token Budget", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Output is ranked by term overlap then truncated at ~4 chars/token so the most relevant nodes survive the cut."}, {"id": "_claude_skills_graphify_references_query_work_memory_loop", "label": "Work Memory Self-Improving Loop", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "save-result / reflect section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save-result with --outcome useful|dead_end|corrected feeds LESSONS.md, so later sessions start from preferred sources, skip known dead ends, and see prior corrections; `reflect --if-stale` keeps it cheap and deterministic."}, {"id": "_claude_skills_graphify_references_query_shortest_path_query", "label": "Shortest Path Query", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify path", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_explain_node", "label": "Explain Node", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify explain", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_references_query_query_expansion", "target": "_claude_skills_graphify_references_query_bfs_dfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 0 -> Step 1", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_bfs_dfs_traversal", "target": "_claude_skills_graphify_references_query_token_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "Step 1 budget block", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_bfs_dfs_traversal", "target": "_claude_skills_graphify_references_query_work_memory_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "save-result section", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_shortest_path_query", "target": "_claude_skills_graphify_references_query_work_memory_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify path", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_explain_node", "target": "_claude_skills_graphify_references_query_work_memory_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "For /graphify explain", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_work_memory_loop", "target": "_claude_skills_graphify_references_update_incremental_update", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "'the next --update will extract this Q&A as a node'", "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_work_memory_loop", "target": "_claude_skills_graphify_references_hooks_post_commit_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": "'if the post-commit hook *is* installed, --if-stale means your session-start run costs almost nothing'", "weight": 1.0}], "hyperedges": []}