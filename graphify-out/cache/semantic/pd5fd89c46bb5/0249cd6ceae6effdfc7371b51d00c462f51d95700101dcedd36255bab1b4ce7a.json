{"nodes": [{"id": "_claude_skills_graphify_references_update_incremental_update", "label": "Incremental Update (--update)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": "For --update", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-extracts only new or changed files to save tokens. `files` carries the changed subset while `all_files` carries the full corpus so later steps still see corpus-wide context."}, {"id": "_claude_skills_graphify_references_update_build_merge", "label": "build_merge Replace-on-Re-extract", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": "build_merge block", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "build_merge reads graph.json directly with no NetworkX round-trip so edge direction survives (#801). prune_sources is only for genuinely deleted files \u2014 adding changed files there would delete the freshly re-extracted content (#1344/#1178), and root= is required or nothing is pruned and stale nodes accumulate (#1361)."}, {"id": "_claude_skills_graphify_references_update_code_only_shortcut", "label": "Code-Only Update Shortcut", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": "code_only check", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If every changed file has a code extension, semantic extraction is skipped entirely \u2014 AST alone is sufficient and costs no tokens."}, {"id": "_claude_skills_graphify_references_update_cluster_only", "label": "Cluster-Only Rerun", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": "For --cluster-only", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`graphify cluster-only .` is self-contained; re-running Steps 5-9 afterwards raises FileNotFoundError because Step 9 cleanup already deleted the intermediate sidecars (#1392)."}, {"id": "_claude_skills_graphify_references_update_graph_diff", "label": "Graph Diff After Update", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": "graph_diff block", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_skill_manifest_stamping", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": "save_manifest block (#2015 mirror note)", "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_references_update_build_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": "build_merge block", "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_references_update_code_only_shortcut", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": "code_only check", "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_code_only_shortcut", "target": "_claude_skills_graphify_skill_ast_structural_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": "'run only Step 3A (AST) on the changed files'", "weight": 1.0}, {"source": "_claude_skills_graphify_references_update_incremental_update", "target": "_claude_skills_graphify_references_transcri