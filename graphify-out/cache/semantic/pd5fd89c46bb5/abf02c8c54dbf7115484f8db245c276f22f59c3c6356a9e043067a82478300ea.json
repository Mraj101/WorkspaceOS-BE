ce_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "For /graphify query", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_update_cluster_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "For --update and --cluster-only", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_exports_wiki_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 6b-8", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_exports_neo4j_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 6b-8", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_exports_falkordb_export", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Steps 6b-8", "weight": 1.0}], "hyperedges": [{"id": "graphify_extraction_integrity_guards", "label": "Extraction Integrity Guards", "nodes": ["_claude_skills_graphify_references_extraction_spec_node_id_format", "_claude_skills_graphify_references_extraction_spec_source_file_rule", "_claude_skills_graphify_skill_shrink_guard", "_claude_skills_graphify_skill_graph_health_check", "_claude_skills_graphify_skill_semantic_extraction_cache"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/graphify/SKILL.md"}]}