{"nodes": [{"id": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "label": "Extraction Subagent Prompt", "file_type": "document", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID Format", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs must be the full repo-relative path stem plus entity so same-named files in different directories stay distinct and the LLM id matches the AST id exactly; using only the filename or immediate parent, or appending chunk suffixes, creates orphan ghost-duplicate nodes."}, {"id": "_claude_skills_graphify_references_extraction_spec_confidence_rubric", "label": "Confidence Score Rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 47-59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A discrete five-value set (0.95/0.85/0.75/0.65/0.55) replaces a continuous range because models collapse ranges to a binary \u2014 production showed >50% of edges at 0.5 and >40% at 0.85+."}, {"id": "_claude_skills_graphify_references_extraction_spec_audit_trail_confidence_tiers", "label": "EXTRACTED / INFERRED / AMBIGUOUS Audit Trail", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 12-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncertain relationships are flagged rather than omitted, so the graph records what it does not know instead of quietly dropping it."}, {"id": "_claude_skills_graphify_references_extraction_spec_hyperedges", "label": "Hyperedges", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 38-42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used only when 3+ nodes share a concept that pairwise edges cannot express; capped at 3 per chunk to keep them informative."}, {"id": "_claude_skills_graphify_references_extraction_spec_source_file_rule", "label": "Verbatim source_file Rule", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copying the FILE_LIST path character-for-character keeps full builds and incremental --update on the same base, so build_merge's replace-on-re-extract matches the existing node instead of accumulating duplicates."}, {"id": "_claude_skills_graphify_references_extraction_spec_semantic_similarity_edge", "label": "semantically_similar_to Edge", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 32-36", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_node_id_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 61", "weight": 1.0}, {"source": "_claude_skills_graphify_references_extraction_spec_extraction_subagent_prompt", "target": "_claude_skills_graphify_references_extraction_spec_confidence_rubric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.